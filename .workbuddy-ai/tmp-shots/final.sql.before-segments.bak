(442,34,'Dịch \"slide\" trong bài thuyết trình sang tiếng Việt.','multiple_choice','\"Slide\" là trang trình chiếu.',NULL,NULL,'intermediate',2,'2026-11-03 17:24:07.000'),
(443,34,'Câu nào mở đầu bài thuyết trình lịch sự?','multiple_choice','Cách mở đầu chuẩn mực là giới thiệu chủ đề.',NULL,NULL,'intermediate',3,'2026-11-03 17:24:07.000'),
(444,34,'Chọn cụm từ đúng: \"Let\'s move ___ to the next point.\"','multiple_choice','Cụm \"move on to\" nghĩa là chuyển sang ý tiếp theo.',NULL,NULL,'intermediate',4,'2026-11-03 17:24:07.000'),
(445,34,'Từ \"audience\" nghĩa là gì?','multiple_choice','\"Audience\" là khán giả/người nghe.',NULL,NULL,'intermediate',5,'2026-11-03 17:24:07.000'),
(446,34,'Bạn nên làm gì khi sắp hết thời gian thuyết trình?','multiple_choice','Tóm tắt ý chính và cảm ơn khán giả.',NULL,NULL,'intermediate',6,'2026-11-03 17:24:07.000'),
(447,34,'Dịch \"in conclusion\" sang tiếng Việt.','multiple_choice','\"In conclusion\" dùng để kết luận.',NULL,NULL,'intermediate',7,'2026-11-03 17:24:07.000'),
(448,34,'Chọn động từ đúng: \"The chart ___ the sales figures.\"','multiple_choice','Chủ ngữ số ít \"the chart\" đi với \"shows\".',NULL,NULL,'intermediate',8,'2026-11-03 17:24:07.000'),
(449,34,'Câu nào mời khán giả đặt câu hỏi?','multiple_choice','Câu mời hỏi lịch sự là \"Are there any questions?\".',NULL,NULL,'intermediate',9,'2026-11-03 17:24:07.000'),
(450,34,'Giao tiếp bằng mắt khi thuyết trình giúp gì?','multiple_choice','Ánh mắt tạo kết nối với khán giả.',NULL,NULL,'intermediate',10,'2026-11-03 17:24:07.000'),
(451,35,'Dịch \"social media\" sang tiếng Việt.','multiple_choice','\"Social media\" là mạng xã hội.',NULL,NULL,'advanced',1,'2026-11-03 17:24:07.000'),
(452,35,'Tin tức giả trong tiếng Anh là gì?','multiple_choice','Cụm \"fake news\" nghĩa là tin giả.',NULL,NULL,'advanced',2,'2026-11-03 17:24:07.000'),
(453,35,'Chọn động từ đúng: \"We should ___ information before sharing it.\"','multiple_choice','Cần kiểm chứng thông tin trước khi chia sẻ.',NULL,NULL,'advanced',3,'2026-11-03 17:24:07.000'),
